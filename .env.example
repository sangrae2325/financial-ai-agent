GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 선택: 로컬 FastAPI 또는 Cloud Run 로그 수집기 URL
# LOG_COLLECTOR_URL=http://localhost:8080

# Cloud Run 배포 시 이 키를 Secret Manager에 등록한다.
# GEMINI_SECRET_NAME=financial-gemini-api-key

# 선택: GCS / BigQuery 적재를 사용할 때만 설정
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_BUCKET=your-gcs-bucket-name
