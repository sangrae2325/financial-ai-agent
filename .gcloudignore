# Cloud Build에 보내지 않을 로컬 파일
.gcloudignore
.git
.gitignore
.env
.venv
__pycache__/
*.py[cod]
.pytest_cache/
tests/
airflow/
log_collector/

# Dockerfile에서 명시적으로 복사하는 운영 데이터만 전송한다.
data/*
!data/chroma/
!data/chroma/**
!data/news/
data/news/*
!data/news/news.json
!data/stocks/
data/stocks/*
!data/stocks/stocks.json
!data/exchange/
data/exchange/*
!data/exchange/exchange.json
